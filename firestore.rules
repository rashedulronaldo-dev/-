                         isValidPayment(incoming(), orgId) && (
                           isOrgAdmin(orgId) ||
                           (incoming().status == 'PENDING' && incoming().webhookVerified == false)
                         );
        // Terminal state locking: only Admin can verify/refund, and REFUNDED is final
        allow update: if isValidId(orgId) && isValidId(paymentId) && isOrgAdmin(orgId) &&
                         existing().status != 'REFUNDED' &&
                         incoming().orgId == existing().orgId &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdAt == existing().createdAt &&
                         isValidPayment(incoming(), orgId) &&
